{
  "name": "game-guides",
  "version": "0.0.0",
  "scripts": {
    "test": "npm run middleware:check && npm run middleware:test && npm run ui:test -- --watch=false && npm run parser:test -- --runInBand",
    "test:security": "tsx --test projects/middleware/src/auth.test.ts projects/middleware/src/auth0.test.ts",
    "ng": "ng",
    "lint": "npm run lint:ci",
    "db:start": "node projects/middleware/database.mjs",
    "parser:start": "tsx projects/data-parser/src/main.ts",
    "parser:lint": "eslint projects/data-parser/src",
    "parser:test": "npx jest --config projects/data-parser/jest.config.ts",
    "ui:build": "ng build",
    "ui:watch": "ng build --watch --configuration development",
    "ui:start": "node projects/middleware/start.mjs",
    "ui:lint": "eslint projects/guides-app/src",
    "ui:e2e": "node projects/middleware/stack-smoke.mjs",
    "ui:test": "ng test",
    "start": "node projects/middleware/start.mjs",
    "ui:only": "ng serve",
    "middleware:migrate": "tsx projects/middleware/src/migrate.ts",
    "middleware:main-quests": "tsx projects/middleware/src/main-quest-migration.ts",
    "middleware:start": "node --watch --watch-preserve-output --import tsx projects/middleware/src/main.ts",
    "middleware:check": "tsc -p projects/middleware/tsconfig.json",
    "middleware:test": "tsx --test projects/middleware/src/*.test.ts",
    "lint:ci": "eslint projects/common projects/middleware/src projects/data-parser/src projects/guides-app/src",
    "common:lint": "eslint projects/common",
    "middleware:lint": "eslint projects/middleware/src"
  },
  "private": true,
  "type": "module",
  "packageManager": "npm@10.8.2",
  "dependencies": {
    "@angular/common": "22.1.7",
    "@angular/compiler": "22.1.7",
    "@angular/core": "22.1.7",
    "@angular/forms": "22.1.7",
    "@angular/platform-browser": "22.1.7",
    "@angular/router": "22.1.7",
    "@auth0/auth0-angular": "^2.13.0",
    "bootstrap": "5.3.2",
    "chalk": "5.3.0",
    "date-fns": "3.3.1",
    "express-oauth2-jwt-bearer": "^1.11.0",
    "marked": "^18.1.0",
    "mongodb": "6.4.0",
    "openid-client": "^6.8.8",
    "puppeteer": "25.11.0",
    "rxjs": "7.8.1",
    "tslib": "2.6.2"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.1.0",
    "@angular-eslint/eslint-plugin": "22.1.0",
    "@angular-eslint/eslint-plugin-template": "22.1.0",
    "@angular-eslint/schematics": "22.1.0",
    "@angular-eslint/template-parser": "22.1.0",
    "@angular/build": "22.1.7",
    "@angular/cli": "22.1.7",
    "@angular/compiler-cli": "22.1.7",
    "@babel/core": "7.23.5",
    "@babel/preset-env": "7.23.5",
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@stylistic/eslint-plugin-ts": "4.4.1",
    "@types/jest": "29.5.11",
    "angular-eslint": "22.1.0",
    "dotenv": "16.3.1",
    "eslint": "10.11.0",
    "eslint-plugin-jest": "29.16.6",
    "eslint-plugin-jsdoc": "64.5.4",
    "jest": "29.7.0",
    "jsdom": "23.0.1",
    "prettier": "3.1.0",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "tsx": "4.7.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "typescript-eslint": "8.70.0"
  }
}
