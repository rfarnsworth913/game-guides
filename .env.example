# Copy this file to .env in the repository root; run commands from that directory.
# Full reference: docs/environment.md. Never commit credentials or your .env.
# Existing shell/container environment variables take precedence over .env.

# Required: shared MongoDB catalog used by the middleware and data parsers.
DB_CONN_STRING=mongodb://127.0.0.1:27017
DB_NAME=gamesData
DB_COLLECTION=games

# Optional local development ports (shown defaults).
MIDDLEWARE_PORT=3001
UI_PORT=4200
# Optional: absolute path to mongod when it is not bundled or on PATH.
# MONGOD_PATH=C:/Program Files/MongoDB/Server/8.0/bin/mongod.exe

# Auth0 public domain/client/audience: projects/lib/constants/auth0-config.constants.ts.
# Configure the SPA and API in Auth0; no client secret is used by the Angular SDK.
# Browser origin only: scheme + hostname + optional port, without a page path.
APP_ORIGIN=http://localhost:4200
# Exact Auth0 user IDs, not email addresses; empty means no shared-data editors.
# Multiple IDs: auth0|first-user,google-oauth2|second-user
# AUTH0_EDITOR_SUBJECTS=auth0|your-editor-subject
# Production requires NODE_ENV=production and an HTTPS APP_ORIGIN.
# NODE_ENV=production

# Parser browser/lock overrides must be set in the shell or scheduler environment.
# They are read before the parser loads .env; see docs/environment.md.
