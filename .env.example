# Use the same values for the parsers and middleware.
DB_CONN_STRING=mongodb://127.0.0.1:27017
DB_NAME=gamesData
DB_COLLECTION=games
MIDDLEWARE_PORT=3001
UI_PORT=4200
# Optional: absolute path to mongod when it is not bundled or on PATH.
# MONGOD_PATH=C:/Program Files/MongoDB/Server/8.0/bin/mongod.exe

# Auth0 public domain/client/audience: projects/common/auth0-config.ts.
# Configure the SPA and API in Auth0; no client secret is used by the Angular SDK.
APP_ORIGIN=http://localhost:4200
# Exact Auth0 user IDs, not email addresses; empty means no shared-data editors.
# AUTH0_EDITOR_SUBJECTS=auth0|your-editor-subject
# Production requires NODE_ENV=production and an HTTPS APP_ORIGIN.
